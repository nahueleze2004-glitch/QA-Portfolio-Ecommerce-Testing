{
  "name": "nahuel-qa-ecommerce-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Risk-based QA practice portfolio for Swag Labs",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:mobile": "cypress run --config viewportWidth=390,viewportHeight=844",
    "test:report": "cypress run --reporter junit --reporter-options mochaFile=reports/results-[hash].xml,toConsole=true"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "cypress": "16.1.1"
  }
}
